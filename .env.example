# Convex deployment
CONVEX_DEPLOYMENT=dev
NEXT_PUBLIC_CONVEX_URL=http://localhost:PORT
NEXT_PUBLIC_CONVEX_SITE_URL=http://localhost:PORT

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# JWT signing (must match the value set on each Convex deployment)
JWT_PRIVATE_KEY="your-jwt-private-key-here"
JWKS="your-jwks-here"

# Resend API key for OTP email delivery (set on the deployment via `convex env set`)
AUTH_RESEND_KEY=your-resend-api-key

# Seeded owner account (required for pnpm seed / init:syncAccounts)
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=your-owner-password

# Seeded staff account (required for pnpm seed / init:syncAccounts)
STAFF_NAME=Staff
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=your-staff-password
